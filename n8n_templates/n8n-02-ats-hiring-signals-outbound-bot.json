{
  "name": "Daily B2B Sales Hiring-Intent Trigger (Greenhouse, Ashby & Lever)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 12
            }
          ]
        }
      },
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.apify.com/v2/acts/brdatahub~global-ats-b2b-hiring-signals/run-sync-get-dataset-items",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "token",
              "value": "YOUR_APIFY_API_TOKEN"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\"greenhouseBoards\": [\"stripe\", \"brex\"], \"ashbyBoards\": [\"linear\"], \"maxJobs\": 30}"
      },
      "name": "BR Data Hub Intelligence API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        300
      ]
    }
  ],
  "connections": {
    "Schedule Trigger": {
      "main": [
        [
          {
            "node": "BR Data Hub Intelligence API",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
